modal_*.py
**/modal_*.py

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Model files
*.bin
*.safetensors
*.ckpt
*.pt
*.pth
models/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
.tmp/

# Experiments results (but keep the directory structure and README files)
experiments/**/models/
experiments/**/logs/
experiments/**/checkpoints/
experiments/**/results/
experiments/**/outputs/
experiments/**/*.json

# Backup files
backup_*/
*.bak
*.bak2
*~
*.old

# Evaluation results
evaluation_results/

# Patches and local working notes (kept on disk, never committed)
patches/
*.patch
*.diff
*.rej
*.orig

# Docs / readmes (*.md is already ignored above; these cover the plain-text ones)
docs/
README
README.txt
readme.txt
NOTES.txt
notes.txt

# Core Python packages must remain versioned despite the broad data/model
# artifact rules above.
!src/models/
!src/models/**/*.py
!src/data/
!src/data/**/*.py
