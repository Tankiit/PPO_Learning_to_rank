{
  "model": "roberta-base",
  "quantize_4bit": false,
  "dropout": 0.1,
  "pooling": "attention",
  "loss": "listnet",
  "loss_temperature": 1.0,
  "dataset": "multinli",
  "data_method": "heuristic",
  "max_length": 256,
  "candidates_per_query": 5,
  "epochs": 30,
  "batch_size": 16,
  "lr": 2e-05,
  "weight_decay": 0.01,
  "warmup_steps": 500,
  "gradient_clip": 1.0,
  "patience": 10,
  "seed": 42,
  "output_dir": "results/multinli_listnet_s42",
  "save_best": true,
  "log_every": 50,
  "eval_every_epoch": 1,
  "device": "auto",
  "num_workers": 4
}